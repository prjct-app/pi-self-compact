{
  "name": "@prjct.app/pi-self-compact",
  "version": "0.4.1",
  "description": "Pi extension: Pi's compaction summary, written by extending the session's cached request. Adds nothing to the context.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-self-compact.git"
  },
  "bugs": {
    "url": "https://github.com/prjct-app/pi-self-compact/issues"
  },
  "homepage": "https://github.com/prjct-app/pi-self-compact#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "compaction",
    "context-window",
    "autonomous-agents"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-self-compact/main/docs/cover.png"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "CONTRIBUTING.md",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run check:immutable",
    "test": "node --import ./tests/isolate.mjs --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "build": "rm -rf build && mkdir -p build && npm pack --ignore-scripts --pack-destination build >/dev/null && tar -xzf build/*.tgz -C build --strip-components=1 && rm -f build/*.tgz",
    "check:immutable": "! grep -rn '\\blet\\b' src/ || (echo 'Use immutable values: no let bindings in src/' && exit 1)",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@prjct.app/pi-secrets": "^0.2.1"
  }
}
